# ============================================================
# PHONEZONE - Environment Configuration
# Đổi thông tin này theo máy của bạn
# ============================================================

# Môi trường: development | production
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/phonezone
APP_NAME=PhoneZone

# Database (XAMPP mặc định)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=phonezone
DB_USER=root
DB_PASS=

# Session
SESSION_NAME=phonezone_session
SESSION_LIFETIME=7200

# Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=public/uploads

# Bảo mật
SECRET_KEY=phonezone_secret_key_2025_change_this
